        <algosdk.version>1.11.0-beta-1</algosdk.version>
        <web3j.core.version>4.14.0</web3j.core.version>
        <web3j.maven.version>4.14.0</web3j.maven.version>
        <com.google.auto.service.version>1.1.1</com.google.auto.service.version>
        <javapoet.version>1.13.0</javapoet.version>
        <annotation-processor-logger.version>1.0</annotation-processor-logger.version>
        <jadexversion>4.0.241</jadexversion>
