##pragma solidity >=0.8.7;

##import "./Mediator.sol";

contract ConcreteMediator is Mediator {
#set( $assignedAgentsToSociety = {} ) ## mapping for assigned agents to society
#set( $isMediator = false ) ## public boolean for isMediator

## Bind an agent to the society
function bindAgent(address _societyAddress, string memory _socialAgentName) override public {
#if( $!{_societyAddress} != "0x0" )
    $assignedAgentsToSociety.put($socialAgentName, $societyAddress);
#else
throw("a social agent should have an address");
#end
}

## Unbind an agent from the society
function unbindAgent(string memory _socialAgentName) override public {
$assignedAgentsToSociety.remove($socialAgentName);
}

## Get the address of an agent from the society
function getAgentFromSociety(string memory _agentName) override public view returns(address) {
## Retrieve the address of the agent from the mapping
#set($agentAddress = $assignedAgentsToSociety.get($agentName))

## Ensure the agent exists
#if( $agentAddress != "0x0" )
return $agentAddress;
#else
throw("Agent not found in the society");
#end
}
}